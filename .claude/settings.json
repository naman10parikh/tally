{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/tally-commit-gate.js\"",
            "timeout": 10,
            "statusMessage": "tally commit-gate: checking for analytics anti-patterns"
          }
        ]
      }
    ]
  }
}
