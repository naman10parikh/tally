# Energy Platform — Environment Variables
# Copy to .env and fill in your keys

# Claude Code / Anthropic
# Get at: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# E2B (Firecracker microVM sandboxes)
# Get at: https://e2b.dev/dashboard
E2B_API_KEY=e2b_...
E2B_AGENT_TEMPLATE=energy-agent

# Clerk (Authentication — SSO, OAuth, Phone)
# Get at: https://dashboard.clerk.com → API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_...
CLERK_SECRET_KEY=sk_...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Stripe (Payments & Subscriptions)
# Get at: https://dashboard.stripe.com/apikeys
STRIPE_PUBLISHABLE_KEY=pk_...
STRIPE_SECRET_KEY=sk_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Google Places (Venue search for agents)
# Get at: https://console.cloud.google.com → APIs & Services → Credentials
GOOGLE_PLACES_API_KEY=AIza...

# Ticketmaster (Event search — free, 5000 calls/day)
# Get at: https://developer.ticketmaster.com/products-and-docs/apis/getting-started/
TICKETMASTER_API_KEY=...

# Composio (Google Workspace — Gmail, Calendar, Sheets, Docs with managed OAuth)
# Get at: https://composio.dev — Free tier: 5K calls/mo
# COMPOSIO_API_KEY=...

# Supabase (Postgres — memory persistence, traces, conversations)
# Get at: https://supabase.com/dashboard → New Project → Settings → API
# Run supabase/migrations/001_user_memories.sql in the SQL Editor after creating the project.
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_ANON_KEY=eyJ...
# SUPABASE_SERVICE_ROLE_KEY=eyJ...  # Optional: bypasses RLS, use for server-side only

# GitHub PAT (for Actions push + MCP)
# Also add as GitHub repo secret named PAT_TOKEN:
# https://github.com/naman10parikh/Energy/settings/secrets/actions/new
GITHUB_PERSONAL_ACCESS_TOKEN=ghp_...

# Web Search — Claude's native web_search tool uses ANTHROPIC_API_KEY ($10/1K searches)
# No separate key needed. Brave/Tavily are optional budget fallbacks.
# BRAVE_API_KEY=...
# TAVILY_API_KEY=...

# Twilio (SMS + Voice — instant setup)
# Get at: https://console.twilio.com (Account SID + Auth Token on dashboard)
# TWILIO_ACCOUNT_SID=AC...
# TWILIO_AUTH_TOKEN=...
# TWILIO_PHONE_NUMBER=+1...

# WhatsApp Cloud API (Direct via Meta — 3-10 days for verification)
# Get at: https://developers.facebook.com/ → WhatsApp product → API Setup
# WHATSAPP_ACCESS_TOKEN=...
# WHATSAPP_PHONE_NUMBER_ID=...
# WHATSAPP_BUSINESS_ACCOUNT_ID=...
# WHATSAPP_WEBHOOK_VERIFY_TOKEN=...

# Cronofy (Unified Calendar — Google + Outlook + Apple)
# Get at: https://app.cronofy.com/sign_up/developer
# CRONOFY_CLIENT_ID=...
# CRONOFY_CLIENT_SECRET=...

# Browserbase (Stagehand cloud browsers + MCP)
# Get at: https://www.browserbase.com/dashboard
BROWSERBASE_API_KEY=bb_...
BROWSERBASE_PROJECT_ID=...

# Firecrawl (Web scraping & crawling MCP)
# Get at: https://www.firecrawl.dev/app/api-keys
FIRECRAWL_API_KEY=fc-...

# Spark Agent Identity (Phase 1: manual, Phase 2: semi-auto, Phase 3: autonomous)
# SPARK_EMAIL=spark@energy-app.com
# SPARK_EMAIL_PASSWORD=...
# SPARK_TWILIO_NUMBER=+1...
# SPARK_INSTAGRAM_USERNAME=sparkbyenergy
# SPARK_INSTAGRAM_PASSWORD=...
# SPARK_TIKTOK_USERNAME=sparkbyenergy
# SPARK_TIKTOK_PASSWORD=...

# Agent Format Extension (configurable — currently .energy)
AGENT_FORMAT_EXTENSION=.energy

# Server
PORT=3001
HOST=0.0.0.0
AGENTS_DIR=agents
DB_PATH=data/energy.db

# ─────────────────────────────────────────────────────────────────────────────
# tally — product-analytics + feature-flags + experiments (net-new, PLAN §8)
# ─────────────────────────────────────────────────────────────────────────────
# THE CORE ACCEPTANCE TEST NEEDS NO SECRETS: a local capture sink + a flagd
# file-backed flag are both local/$0. Secrets live ONLY at the live-PostHog and
# E2B-sandbox edges. Provision on a free or test tier;
# anything needing payment/2FA/phone → CHAIRMAN-CHECKLIST. Env refs only — NEVER
# put a real key here or in .mcp.json.

# Tier 0 · PostHog (the default backend — analytics + flags + experiments).
# KEY-CLASS RULE (P4 — do not mix): the PROJECT (public) key is for capture +
# flag-decide (unmetered ingest); the PERSONAL key is for reads + flag-management
# (rate-limited). Using the wrong class → 401s on decide or rate-limited capture.
# POSTHOG_PERSONAL_API_KEY=phx_...        # reads/management; scope >= Query Read + Zapier (NEVER for capture)
# POSTHOG_PROJECT_API_KEY=phc_...         # capture/decide ONLY (public, unmetered ingest)
# POSTHOG_HOST=https://us.i.posthog.com   # or https://eu.i.posthog.com / self-host (defaults to US cloud)
# POSTHOG_PROJECT_ID=12345                # numeric id, for /api/project/:id/query (the live-query variant)

# Tier 1 · flagd (the $0 OSS flag loop — NO SECRET NEEDED, flagd's killer property).
# The file-backed, in-process resolver is the autonomous/$0 path the acceptance
# test wires (no SaaS key, hot-reload). These are config, not secrets.
# FLAGD_HOST=localhost
# FLAGD_PORT=8016                          # flagd serves OFREP on 8016
# FLAGD_RESOLVER=in-process                # in-process | rpc (in-process = no daemon, $0)
# FLAGD_SOURCE_PATH=flags/flags.json       # the file-backed flag source tally writes

# E2B (Firecracker sandbox-boot eval, E4) — ALREADY in energy/.env (port via CP122).
# Absent → the sandbox-boot eval is skipped; the local acceptance test still gates the merge.
# E2B_API_KEY is declared in the E2B block above.

# CLAUDE_CODE_OAUTH_TOKEN — DEFERRED (D8). Lights the RSI loop's Claude (LLM-authored)
# half; the deterministic RSI loop runs $0/tokenless without it. Set per chairman checklist.
# CLAUDE_CODE_OAUTH_TOKEN=...

# Tier 2 · opt-in alternates (documented, NOT wired — only if deliberately chosen).
# GrowthBook = the serious-stats bolt-on via OpenFeature for ONE load-bearing metric
# (NOT a rip-and-replace of PostHog, O17). Plausible = the WEB-STATS plane (replaces
# GA4, not PostHog, O18) — a DIFFERENT plane, not the product-analytics acceptance test.
# GROWTHBOOK_API_HOST=...
# GROWTHBOOK_CLIENT_KEY=...
# GROWTHBOOK_API_KEY=...
# PLAUSIBLE_API_KEY=...
# PLAUSIBLE_SITE_ID=...

# EXPLICITLY NOT tally's secrets (the three-plane boundary, O18):
#   • gen_ai.usage.* / any LLM-token-cost source  → agentmoney's plane (NEVER piped into PostHog)
#   • SENTRY_* / OTEL_* / any app-health key       → canary's plane
#   • STATSIG_* / LAUNCHDARKLY_* / AMPLITUDE_* / MIXPANEL_*  → documented alts only if chosen (TOOL-MATRIX §13 Tier 2)
#   • SEGMENT_WRITE_KEY / RUDDERSTACK_*            → a CDP is the pipe IN FRONT of PostHog, only at >=3 destinations
