# wikimem
.wikimem-cache/
node_modules/

# WikiMem test vault personal data
my-wiki/raw/
tools/agentgrid/app/release/

packages/web/.next/
*.pack

# macOS metadata
**/.DS_Store

# Ephemeral harness state (never commit)
.claude/settings.local.json
.claude/worktrees/
.claude/backups/
.claude/scheduled_tasks.lock
.claude/vp-signals/*.done
.claude/vp-signals/*.needs-qa
.claude/vp-signals/*.migrating

# Obsidian temp files
vault/Untitled*.base

.env

# tally — build output + runtime artifacts (B-CLI)
dist/
*.tsbuildinfo
# dogfooded run telemetry (Observability layer a) — append-only runtime state
logs/runs.jsonl
# command-generated runtime artifacts (track-plan / capture-event / wire-flag)
.tally-plan/
.capture/
flags/flags.json
# dogfood commit-gate runtime log (Hooks layer, B8) — append-only runtime state, not source
.claude/tally-gate.log
